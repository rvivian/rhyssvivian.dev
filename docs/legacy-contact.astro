---
// Archived during the field-journal rebuild.
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/profile";
---

<BaseLayout title="Contact" description="Contact Rhyss Vivian by email, LinkedIn, or GitHub.">
  <section class="border-b theme-border theme-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] theme-eyebrow">Contact</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-normal theme-text sm:text-5xl">
        Useful conversations usually start with context.
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 theme-muted">
        I am open to platform, infrastructure, cybersecurity, and technology leadership conversations,
        especially where the work connects technical depth with organizational direction.
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-5 px-4 py-16 sm:px-6 md:grid-cols-3 lg:py-20">
    <a class="rounded-lg border theme-card p-6 hover:border-teal-500 focus-ring" href={`mailto:${site.email}`}>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] theme-eyebrow">Email</p>
      <h2 class="mt-3 text-xl font-semibold tracking-normal theme-text">{site.email}</h2>
      <p class="mt-3 leading-7 theme-muted">Best for direct notes and role-specific conversations.</p>
    </a>
    <a class="rounded-lg border theme-card p-6 hover:border-teal-500 focus-ring" href={site.linkedInUrl}>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] theme-eyebrow">LinkedIn</p>
      <h2 class="mt-3 text-xl font-semibold tracking-normal theme-text">Professional profile</h2>
      <p class="mt-3 leading-7 theme-muted">Best for work history, network context, and leadership opportunities.</p>
    </a>
    <a class="rounded-lg border theme-card p-6 hover:border-teal-500 focus-ring" href={site.githubUrl}>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] theme-eyebrow">GitHub</p>
      <h2 class="mt-3 text-xl font-semibold tracking-normal theme-text">Builder work</h2>
      <p class="mt-3 leading-7 theme-muted">Best for projects, experiments, and hands-on technical work.</p>
    </a>
  </section>
</BaseLayout>
