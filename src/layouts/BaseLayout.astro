---
import SiteFooter from "../components/FieldFooter.astro";
import SiteHeader from "../components/FieldHeader.astro";
import { site } from "../data/profile";
// set:html is safe here: the value is a constant authored in the repo, never user input.
import { themeInitScript } from "../scripts/theme-init.js";
import { CF_PAGES_COMMIT_SHA } from "astro:env/server";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/monaspace-argon/400.css";
import "@fontsource/monaspace-argon/500.css";
import "@fontsource/monaspace-argon/600.css";
import "@fontsource/monaspace-krypton/400.css";
import "../styles/field-journal.css";

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
}

const { title = site.title, description = site.description, image } = Astro.props;
const pageTitle = title === site.title ? title : `${title} | ${site.name}`;
const canonicalUrl = new URL(Astro.url.pathname, `https://${site.domain}`).toString();
const imageUrl = image === null
  ? null
  : new URL(image ?? "/og.png", `https://${site.domain}`).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {CF_PAGES_COMMIT_SHA && <meta name="build-commit" content={CF_PAGES_COMMIT_SHA} />}
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c1517" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <title>{pageTitle}</title>
    <script is:inline set:html={themeInitScript} />
  </head>
  <body class="min-h-screen antialiased">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
