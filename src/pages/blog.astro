---
import { getCollection } from "astro:content";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Blog" description="Writing from Rhys Vivian on leadership, platform, infrastructure, cybersecurity, and MBA work.">
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <SectionHeading
        eyebrow="Blog"
        title="A place for the writing habit to grow."
        description="Future essays will connect platform work, cybersecurity, leadership, infrastructure, and business school reflections."
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
    {
      posts.length > 0 ? (
        <div class="grid gap-5 md:grid-cols-2">
          {posts.map((post) => (
            <article class="rounded-lg border border-slate-200 bg-white p-6">
              <p class="text-sm font-semibold text-teal-700">{post.data.pubDate.toLocaleDateString("en-US")}</p>
              <h2 class="mt-3 text-xl font-semibold tracking-normal text-slate-950">
                <a class="hover:text-teal-800" href={`/blog/${post.id}`}>
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 leading-7 text-slate-600">{post.data.description}</p>
            </article>
          ))}
        </div>
      ) : (
        <div class="max-w-2xl rounded-lg border border-slate-200 bg-white p-6">
          <h2 class="text-xl font-semibold tracking-normal text-slate-950">Writing starts here.</h2>
          <p class="mt-3 leading-7 text-slate-600">
            This section is ready for Markdown posts when there is something worth publishing.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
