---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article>
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:py-20">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-700">
          {project.data.category} / {project.data.year}
        </p>
        <h1 class="mt-4 text-4xl font-semibold tracking-normal text-slate-950 sm:text-5xl">
          {project.data.title}
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-600">{project.data.summary}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {project.data.tags.map((tag) => <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">{tag}</span>)}
        </div>
      </div>
    </header>

    <div class="mx-auto grid max-w-4xl gap-10 px-4 py-12 sm:px-6 lg:py-16">
      <section>
        <h2 class="text-xl font-semibold tracking-normal text-slate-950">Impact</h2>
        <ul class="mt-4 grid gap-3">
          {
            project.data.impact.map((item) => (
              <li class="rounded-lg border border-slate-200 bg-white p-4 leading-7 text-slate-700">{item}</li>
            ))
          }
        </ul>
      </section>
      <section class="content">
        <Content />
      </section>
    </div>
  </article>
</BaseLayout>
