---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentMeta from "../../components/ContentMeta.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary} image={null}>
  <article>
    <header class="site-shell py-16 sm:py-24">
      <a class="text-link" href="/projects">Project index</a>
      <div class="mt-12 max-w-4xl">
        <ContentMeta topic={project.data.category} date={project.data.year} location={project.data.location} />
        <h1 class="mt-6 text-4xl font-medium leading-[1.05] tracking-[-0.055em] theme-text sm:text-6xl">{project.data.title}</h1>
        <p class="mt-7 max-w-2xl text-xl leading-8 theme-muted">{project.data.summary}</p>
      </div>
    </header>
    <div class="section-rule">
      <div class="site-shell grid gap-10 py-12 lg:grid-cols-[12rem_minmax(0,44rem)] lg:gap-16 lg:py-20">
        <aside>
          <p class="section-label">Observed impact</p>
          <p class="meta mt-4 text-[0.62rem] uppercase tracking-[0.11em] theme-soft">Status / {project.data.status}</p>
        </aside>
        <div>
          <ul class="grid gap-4">
            {project.data.impact.map((item, index) => (
              <li class="grid grid-cols-[2rem_1fr] gap-4 border-t theme-border py-5 leading-7 theme-muted">
                <span class="meta text-[0.62rem] theme-soft">{String(index + 1).padStart(2, "0")}</span><span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="content mt-10"><Content /></div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
