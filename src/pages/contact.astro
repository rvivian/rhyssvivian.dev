---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/profile";
---

<BaseLayout title="Contact" description="Contact Rhyss Vivian by email, LinkedIn, or GitHub.">
  <section class="site-shell py-20 sm:py-28">
    <p class="kicker">Contact · Open channel</p>
    <h1 class="mt-6 max-w-4xl text-5xl font-medium leading-[1.02] tracking-[-0.06em] theme-text sm:text-7xl">Useful conversations usually start with context.</h1>
    <p class="mt-7 max-w-2xl text-lg leading-8 theme-muted">I am open to conversations about infrastructure, security, platforms, and technology leadership—especially where technical depth and organizational direction need to meet.</p>
    <div class="mt-14 grid gap-4 sm:grid-cols-3">
      <a class="group border theme-card p-6 no-underline focus-ring" href={`mailto:${site.email}`}><span class="section-label">01 / Email</span><strong class="mt-8 block font-display font-medium theme-text group-hover:underline">{site.email}</strong></a>
      <a class="group border theme-card p-6 no-underline focus-ring" href={site.linkedInUrl}><span class="section-label">02 / LinkedIn</span><strong class="mt-8 block font-display font-medium theme-text group-hover:underline">Professional profile</strong></a>
      <a class="group border theme-card p-6 no-underline focus-ring" href={site.githubUrl}><span class="section-label">03 / GitHub</span><strong class="mt-8 block font-display font-medium theme-text group-hover:underline">Builder work</strong></a>
    </div>
  </section>
</BaseLayout>
