---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/profile";
---

<BaseLayout title="Contact" description="Contact Rhys Vivian by email, LinkedIn, or GitHub.">
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-700">Contact</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-normal text-slate-950 sm:text-5xl">
        Useful conversations usually start with context.
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
        I am open to platform, infrastructure, cybersecurity, and technology leadership conversations,
        especially where the work connects technical depth with organizational direction.
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-5 px-4 py-16 sm:px-6 md:grid-cols-3 lg:py-20">
    <a class="rounded-lg border border-slate-200 bg-white p-6 hover:border-teal-700" href={`mailto:${site.email}`}>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">Email</p>
      <h2 class="mt-3 text-xl font-semibold tracking-normal text-slate-950">{site.email}</h2>
      <p class="mt-3 leading-7 text-slate-600">Best for direct notes and role-specific conversations.</p>
    </a>
    <a class="rounded-lg border border-slate-200 bg-white p-6 hover:border-teal-700" href={site.linkedInUrl}>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">LinkedIn</p>
      <h2 class="mt-3 text-xl font-semibold tracking-normal text-slate-950">Professional profile</h2>
      <p class="mt-3 leading-7 text-slate-600">Best for work history, network context, and leadership opportunities.</p>
    </a>
    <a class="rounded-lg border border-slate-200 bg-white p-6 hover:border-teal-700" href={site.githubUrl}>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">GitHub</p>
      <h2 class="mt-3 text-xl font-semibold tracking-normal text-slate-950">Builder work</h2>
      <p class="mt-3 leading-7 text-slate-600">Best for projects, experiments, and hands-on technical work.</p>
    </a>
  </section>
</BaseLayout>
