---
import { site } from "../data/profile";
---

<footer class="border-t theme-border theme-surface">
  <div class="mx-auto grid max-w-6xl gap-6 px-4 py-8 text-sm theme-muted sm:px-6 md:grid-cols-[1fr_auto]">
    <div>
      <p class="font-semibold theme-text">{site.name}</p>
      <p class="mt-2 max-w-2xl">
        Infrastructure, cybersecurity, platform, and technology leadership.
      </p>
    </div>
    <div class="flex flex-wrap items-start gap-4 md:justify-end">
      <a class="footer-link" href={`mailto:${site.email}`}>Email</a>
      <a class="footer-link" href={site.linkedInUrl}>LinkedIn</a>
      <a class="footer-link" href={site.githubUrl}>GitHub</a>
    </div>
  </div>
</footer>
