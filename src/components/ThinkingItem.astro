---
import type { CollectionEntry } from "astro:content";
import ContentMeta from "./ContentMeta.astro";
import { formatDate, readingTime } from "../utils/content";

interface Props { post: CollectionEntry<"blog">; index?: number; }
const { post, index } = Astro.props;
---

<article class="group grid gap-5 border-t theme-border py-7 sm:grid-cols-[3rem_1fr] sm:py-9">
  {index !== undefined && <span class="meta text-[0.65rem] theme-soft">{String(index + 1).padStart(2, "0")}</span>}
  <div>
    <ContentMeta topic={post.data.topic} date={formatDate(post.data.pubDate)} minutes={readingTime(post.body ?? "")} location={post.data.location} />
    <h3 class="mt-4 text-xl font-medium leading-snug tracking-[-0.035em] theme-text sm:text-2xl">
      <a class="focus-ring no-underline group-hover:underline" href={`/thinking/${post.id}`}>{post.data.title}</a>
    </h3>
    <p class="mt-3 max-w-2xl leading-7 theme-muted">{post.data.description}</p>
  </div>
</article>
