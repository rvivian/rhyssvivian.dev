---
import type { CollectionEntry } from "astro:content";
import ContentMeta from "./ContentMeta.astro";

interface Props { project: CollectionEntry<"projects">; index?: number; }
const { project, index } = Astro.props;
---

<article class="group relative overflow-hidden border theme-card p-6 sm:p-8">
  <div class="absolute right-0 top-0 h-20 w-20 border-b border-l theme-border opacity-60" aria-hidden="true"></div>
  <div class="relative">
    <ContentMeta topic={project.data.category} date={project.data.year} location={project.data.location} />
    <p class="meta mt-10 text-[0.65rem] uppercase tracking-[0.12em] theme-soft">Route {String((index ?? 0) + 1).padStart(2, "0")}</p>
    <h3 class="mt-3 text-2xl font-medium leading-tight tracking-[-0.04em] theme-text">
      <a class="focus-ring no-underline group-hover:underline" href={`/projects/${project.id}`}>{project.data.title}</a>
    </h3>
    <p class="mt-4 leading-7 theme-muted">{project.data.summary}</p>
    <div class="mt-7 flex flex-wrap gap-x-4 gap-y-2">
      {project.data.tags.slice(0, 3).map((tag) => <span class="meta text-[0.62rem] uppercase tracking-[0.1em] theme-soft">{tag}</span>)}
    </div>
  </div>
</article>
