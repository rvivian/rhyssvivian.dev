---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const statusLabel = {
  complete: "Complete",
  "in-progress": "In progress",
  planned: "Planned",
}[project.data.status];
---

<article class="rounded-lg border theme-card p-5">
  <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] theme-soft">
    <span>{project.data.category}</span>
    <span aria-hidden="true">/</span>
    <span>{project.data.year}</span>
  </div>
  <h3 class="mt-4 text-xl font-semibold tracking-normal theme-text">
    <a class="hover:underline focus-ring" href={`/projects/${project.id}`}>
      {project.data.title}
    </a>
  </h3>
  <p class="mt-3 leading-7 theme-muted">{project.data.summary}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    <span class="rounded-md px-2.5 py-1 text-xs font-semibold theme-status">
      {statusLabel}
    </span>
    {
      project.data.tags.slice(0, 4).map((tag) => (
        <span class="rounded-md px-2.5 py-1 text-xs font-medium theme-tag">{tag}</span>
      ))
    }
  </div>
</article>
