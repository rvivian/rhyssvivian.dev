---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.18em] theme-eyebrow">{eyebrow}</p>}
  <h2 class="mt-3 text-3xl font-semibold tracking-normal theme-text sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-lg leading-8 theme-muted">{description}</p>}
</div>
